# העתיקי לקובץ .env בשרת הפרודקשן ומלאי ערכים אמיתיים. .env לא נכנס ל-git (ראו .gitignore).
# שימוש: docker compose -f docker-compose.prod.yml up -d --build

# הדומיין שהאתר רץ עליו (למשל app.example.co.il) — Caddy מבקש דרכו תעודת HTTPS אוטומטית.
DOMAIN=app.example.co.il

# כתובות ציבוריות — CLIENT_URL משמש ל-CORS ולקישורים ב-emails; API_BASE_URL לקישורים שה-API עצמו מייצר.
CLIENT_URL=https://app.example.co.il
API_BASE_URL=https://app.example.co.il/api

# סיסמת ה-DB (גם ה-container של Postgres וגם ה-API קוראים את אותו ערך).
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# מפתח חתימת JWT — 32+ בתים אקראיים. אפשר לייצר עם: openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-bytes

# מייל יוצא (SendGrid) — ראו סעיף "Production email" ב-README ליצירת חשבון/מפתח/אימות דומיין.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.co.il
EMAIL_FROM_NAME=תלמידון

# משתמש-על יחיד לתחזוקת המערכת — אופציונלי; אם ריק, לא ייווצר חשבון מנהל.
ADMIN_EMAIL=
ADMIN_PASSWORD=
